# Base de datos PostgreSQL (Railway u otro proveedor)
# Ejemplo: postgresql://postgres:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@host:port/database"

# Secreto de sesión JWT (generar con `openssl rand -hex 32`)
AUTH_SECRET="your-32-byte-hex-secret-key-here"

# URL pública de la aplicación
NEXT_PUBLIC_APP_URL="https://tu-servicio.up.railway.app"

# Cloudinary Multimedia (opcional, necesario para subida de fotos/videos)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
